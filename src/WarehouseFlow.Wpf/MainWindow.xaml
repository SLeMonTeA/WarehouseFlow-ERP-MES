<Window x:Class="WarehouseFlow.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WarehouseFlow WMS - WPF 仓储运营工作台" Height="760" Width="1280"
        MinHeight="650" MinWidth="1100" WindowStartupLocation="CenterScreen" Background="#F6F8FB">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="12,7"/><Setter Property="Background" Value="#4F46E5"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style TargetType="TextBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="8,6"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="10,9"/><Setter Property="Background" Value="#F8FAFC"/><Setter Property="Foreground" Value="#64748B"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#172033">
            <Grid Margin="14,22">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="WarehouseFlow" Foreground="White" FontSize="18" FontWeight="Bold"/><TextBlock Text="WMS 仓储中心" Foreground="#9AA7BF" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                <TextBlock Grid.Row="1" Text="业务工作台" Foreground="#73809B" FontSize="11" Margin="2,38,0,12"/>
                <TreeView x:Name="NavigationTree" Grid.Row="2" Background="Transparent" BorderThickness="0" Foreground="#D0D8E7" SelectedItemChanged="NavigationTree_SelectedItemChanged">
                    <TreeView.Resources>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Foreground" Value="#D0D8E7"/>
                            <Setter Property="Padding" Value="4,7"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="FontSize" Value="13"/>
                        </Style>
                    </TreeView.Resources>
                    <TreeViewItem x:Name="WorkspaceGroup" Header="工作台" IsExpanded="True" FontWeight="SemiBold" Foreground="#91A0BA">
                        <TreeViewItem x:Name="DashboardNode" Header="总览看板" Tag="0"/>
                    </TreeViewItem>
                    <TreeViewItem x:Name="InventoryGroup" Header="库存管理" IsExpanded="True" FontWeight="SemiBold" Foreground="#91A0BA">
                        <TreeViewItem x:Name="InventoryNode" Header="库存余额与库内作业" Tag="1"/>
                        <TreeViewItem x:Name="InboundNode" Header="入库单" Tag="2"/>
                        <TreeViewItem x:Name="OutboundNode" Header="出库单" Tag="3"/>
                        <TreeViewItem x:Name="QualityNode" Header="收货质检" Tag="11"/>
                        <TreeViewItem x:Name="ReturnsNode" Header="采购/销售退货" Tag="12"/>
                    </TreeViewItem>
                    <TreeViewItem x:Name="MasterDataGroup" Header="基础资料" IsExpanded="True" FontWeight="SemiBold" Foreground="#91A0BA">
                        <TreeViewItem x:Name="MasterDataNode" Header="物料、仓库与库位" Tag="4"/>
                    </TreeViewItem>
                    <TreeViewItem x:Name="SalesGroup" Header="销售业务" IsExpanded="True" FontWeight="SemiBold" Foreground="#91A0BA">
                        <TreeViewItem x:Name="SalesOrderNode" Header="销售订单" Tag="5"/>
                        <TreeViewItem x:Name="DeliveryNoticeNode" Header="发货通知单" Tag="7"/>
                    </TreeViewItem>
                    <TreeViewItem x:Name="PurchaseGroup" Header="采购业务" IsExpanded="True" FontWeight="SemiBold" Foreground="#91A0BA">
                        <TreeViewItem x:Name="PurchaseOrderNode" Header="采购订单" Tag="10"/>
                        <TreeViewItem x:Name="ReceiptNoticeNode" Header="收货通知单" Tag="8"/>
                    </TreeViewItem>
                    <TreeViewItem x:Name="PlanningGroup" Header="生产计划" IsExpanded="True" FontWeight="SemiBold" Foreground="#91A0BA">
                        <TreeViewItem x:Name="PlanningNode" Header="BOM 与 MRP 计划" Tag="6"/>
                        <TreeViewItem x:Name="ProductionOrderNode" Header="生产订单" Tag="9"/>
                    </TreeViewItem>
                    <TreeViewItem x:Name="SecurityGroup" Header="系统管理" IsExpanded="True" FontWeight="SemiBold" Foreground="#91A0BA">
                        <TreeViewItem x:Name="SecurityNode" Header="用户、角色与权限" Tag="13"/>
                    </TreeViewItem>
                </TreeView>
                <StackPanel Grid.Row="3"><Border BorderBrush="#2B3650" BorderThickness="0,1,0,0" Padding="0,14,0,0"/><TextBlock Text="个人项目 Demo" Foreground="#6F7B95" FontSize="11"/><TextBlock Text=".NET 10 · SQL Server" Foreground="#6F7B95" FontSize="11" Margin="0,4,0,0"/></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="#E9EDF3" BorderThickness="0,0,0,1">
                <DockPanel Margin="24,0">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="API" Foreground="#64748B" VerticalAlignment="Center"/><TextBox x:Name="ApiUrlBox" Width="175" Text="http://localhost:5101"/><TextBlock Text="账号" Foreground="#64748B" VerticalAlignment="Center" Margin="10,0,0,0"/><TextBox x:Name="UserBox" Width="70" Text="admin"/><PasswordBox x:Name="PasswordBox" Width="80" Margin="4"/><Button Content="登录" Click="Login_Click"/></StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="刷新数据" Click="Refresh_Click" Background="#EEF2FF" Foreground="#4F46E5"/><TextBlock x:Name="StatusText" Text="未登录" Foreground="#64748B" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
                </DockPanel>
            </Border>
            <TabControl x:Name="MainTabs" Grid.Row="1" Margin="24,24" Background="Transparent">
                <TabItem Header="仓储总览" Padding="14,7"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><UniformGrid Columns="4" Margin="0,0,0,20"><Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,12,0"><StackPanel><TextBlock Text="库存总量" Foreground="#64748B"/><TextBlock x:Name="TotalOnHandText" Text="-" FontSize="25" FontWeight="Bold" Foreground="#4F46E5" Margin="0,8,0,0"/><TextBlock Text="所有库位" Foreground="#AAB4C8" FontSize="11"/></StackPanel></Border><Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,12,0"><StackPanel><TextBlock Text="可用库存" Foreground="#64748B"/><TextBlock x:Name="TotalAvailableText" Text="-" FontSize="25" FontWeight="Bold" Foreground="#059669" Margin="0,8,0,0"/><TextBlock Text="扣除预占后" Foreground="#AAB4C8" FontSize="11"/></StackPanel></Border><Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,12,0"><StackPanel><TextBlock Text="低库存 SKU" Foreground="#64748B"/><TextBlock x:Name="LowStockText" Text="-" FontSize="25" FontWeight="Bold" Foreground="#D97706" Margin="0,8,0,0"/><TextBlock Text="需要补货关注" Foreground="#AAB4C8" FontSize="11"/></StackPanel></Border><Border Background="White" CornerRadius="10" Padding="16"><StackPanel><TextBlock Text="待处理单据" Foreground="#64748B"/><TextBlock x:Name="PendingText" Text="-" FontSize="25" FontWeight="Bold" Foreground="#9333EA" Margin="0,8,0,0"/><TextBlock Text="入库 + 出库" Foreground="#AAB4C8" FontSize="11"/></StackPanel></Border></UniformGrid><Border Grid.Row="1" Background="White" CornerRadius="10" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="近期库存流水" FontSize="16" FontWeight="SemiBold" Foreground="#172033" Margin="0,0,0,12"/><DataGrid x:Name="DashboardGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="0" CanUserAddRows="False" /></Grid></Border></Grid></TabItem>
                <TabItem Header="库存管理" Padding="14,7"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Button Content="刷新库存" Click="Refresh_Click"/><TextBlock Text="库存余额、预占量和安全库存" Foreground="#64748B" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="SKU" Foreground="#64748B" VerticalAlignment="Center"/><TextBox x:Name="AdjustSkuBox" Width="80" Text="RM-1001"/><TextBlock Text="库位" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="AdjustLocationBox" Width="80" Text="A-01-01"/><TextBlock Text="调整量" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="AdjustQuantityBox" Width="55" Text="1"/><TextBlock Text="原因" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="AdjustReasonBox" Width="90" Text="盘点调整"/><Button Content="保存库存调整" Click="AdjustInventory_Click"/><TextBlock Text="正数增加、负数减少；不能低于已预占库存" Foreground="#64748B" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel><TabControl Grid.Row="2" Margin="0,14,0,0"><TabItem Header="库存余额"><DataGrid x:Name="InventoryGrid" AutoGenerateColumns="True" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="0" CanUserAddRows="False"/></TabItem><TabItem Header="库存调拨"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="单号" Foreground="#64748B" VerticalAlignment="Center"/><TextBox x:Name="TransferNoBox" Width="90" Text="TR-NEW-001"/><TextBlock Text="来源" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="TransferFromBox" Width="75" Text="A-01-01"/><TextBlock Text="目标" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="TransferToBox" Width="75" Text="B-01-01"/><TextBlock Text="SKU" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="TransferSkuBox" Width="75" Text="RM-1001"/><TextBlock Text="数量" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="TransferQtyBox" Width="45" Text="5"/><Button Content="保存调拨单" Click="CreateTransfer_Click"/><Button Content="执行调拨" Click="ApplyTransfer_Click"/></StackPanel><DataGrid x:Name="TransferGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" Margin="0,12,0,0"/></Grid></TabItem><TabItem Header="库存盘点"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="单号" Foreground="#64748B" VerticalAlignment="Center"/><TextBox x:Name="StocktakeNoBox" Width="90" Text="ST-NEW-001"/><TextBlock Text="库位" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="StocktakeLocationBox" Width="75" Text="A-01-01"/><TextBlock Text="SKU" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="StocktakeSkuBox" Width="75" Text="RM-1001"/><TextBlock Text="实盘数" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="StocktakeQtyBox" Width="55" Text="1200"/><Button Content="保存盘点单" Click="CreateStocktake_Click"/><Button Content="应用盘点差异" Click="ApplyStocktake_Click"/></StackPanel><DataGrid x:Name="StocktakeGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" Margin="0,12,0,0"/></Grid></TabItem></TabControl></Grid></TabItem>
                <TabItem Header="入库管理" Padding="14,7"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="新建入库单" FontWeight="SemiBold" Foreground="#172033" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="单号" Foreground="#64748B" VerticalAlignment="Center"/><TextBox x:Name="InboundCreateNoBox" Width="100" Text="IN-NEW-001"/><TextBlock Text="供应商" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="InboundCreateSupplierBox" Width="95" Text="演示供应商"/><TextBlock Text="SKU（可多条）" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="InboundCreateSkuBox" Width="80" Text="RM-1001"/><TextBlock Text="数量" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="InboundCreateQtyBox" Width="55" Text="10"/><TextBlock Text="预计到货" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="InboundCreateExpectedBox" Width="95" Text="2026-09-30"/><Button Content="新建入库单" Click="CreateInboundOrder_Click"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0"><Button Content="收货入库" Click="ReceiveInbound_Click"/><Button Content="查看详情/审计" Click="InboundDetail_Click"/><TextBlock Text="目标库位" Foreground="#64748B" VerticalAlignment="Center" Margin="12,0,4,0"/><TextBox x:Name="LocationBox" Width="100" Text="A-01-01"/><TextBlock Text="部分 SKU" Foreground="#64748B" VerticalAlignment="Center" Margin="12,0,4,0"/><TextBox x:Name="InboundSkuBox" Width="90"/><TextBlock Text="数量" Foreground="#64748B" VerticalAlignment="Center" Margin="6,0,4,0"/><TextBox x:Name="InboundQtyBox" Width="55"/><TextBlock Text="批次" Foreground="#64748B" VerticalAlignment="Center" Margin="6,0,4,0"/><TextBox x:Name="InboundBatchBox" Width="90" Text="UNBATCHED"/><TextBlock Text="效期" Foreground="#64748B" VerticalAlignment="Center" Margin="6,0,4,0"/><TextBox x:Name="InboundExpiryBox" Width="95"/><TextBlock Text="空白表示整单收货" Foreground="#64748B" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel><DataGrid x:Name="InboundGrid" Grid.Row="2" AutoGenerateColumns="True" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="0" CanUserAddRows="False" Margin="0,14,0,0"/></Grid></TabItem>
                 <TabItem Header="出库管理" Padding="14,7"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="新建出库单" FontWeight="SemiBold" Foreground="#172033" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="单号" Foreground="#64748B" VerticalAlignment="Center"/><TextBox x:Name="OutboundCreateNoBox" Width="100" Text="OUT-NEW-001"/><TextBlock Text="客户" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="OutboundCreateCustomerBox" Width="95" Text="演示客户"/><TextBlock Text="SKU（可多条）" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="OutboundCreateSkuBox" Width="80" Text="FG-2001"/><TextBlock Text="数量" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="OutboundCreateQtyBox" Width="55" Text="10"/><TextBlock Text="需求日期" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="OutboundCreateRequiredBox" Width="95" Text="2026-09-30"/><Button Content="新建出库单" Click="CreateOutboundOrder_Click"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0"><Button Content="库存预占" Click="ReserveOutbound_Click"/><Button Content="释放预占" Click="ReleaseOutbound_Click"/><Button Content="确认发货" Click="ShipOutbound_Click"/><Button Content="取消出库单" Click="CancelOutbound_Click"/><Button Content="查看详情/审计" Click="OutboundDetail_Click"/><TextBlock Text="部分 SKU" Foreground="#64748B" VerticalAlignment="Center" Margin="12,0,4,0"/><TextBox x:Name="OutboundSkuBox" Width="90"/><TextBlock Text="数量" Foreground="#64748B" VerticalAlignment="Center" Margin="6,0,4,0"/><TextBox x:Name="OutboundQtyBox" Width="55"/><TextBlock Text="空白表示按可执行量" Foreground="#64748B" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel><DataGrid x:Name="OutboundGrid" Grid.Row="2" AutoGenerateColumns="True" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="0" CanUserAddRows="False" Margin="0,14,0,0"/></Grid></TabItem>
                <TabItem Header="基础资料" Padding="14,7"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="物料档案、仓库和库位" FontSize="16" FontWeight="SemiBold" Foreground="#172033"/><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="仓库编码" Foreground="#64748B" VerticalAlignment="Center"/><TextBox x:Name="WarehouseCodeBox" Width="70" Text="WH-02"/><TextBlock Text="名称" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="WarehouseNameBox" Width="80" Text="二号仓"/><TextBlock Text="地址" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="WarehouseAddressBox" Width="85" Text="华南工厂"/><Button Content="新增仓库" Click="CreateWarehouse_Click"/><TextBlock Text="库位仓库" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="LocationWarehouseBox" Width="70" Text="WH-01"/><TextBlock Text="库位编码" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="LocationCodeBox" Width="70" Text="D-01-01"/><TextBlock Text="分区" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="LocationZoneBox" Width="70" Text="成品区"/><TextBlock Text="容量" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="LocationCapacityBox" Width="55" Text="1000"/><Button Content="新增库位" Click="CreateLocation_Click"/></StackPanel><TabControl Grid.Row="2" Margin="0,14,0,0"><TabItem Header="物料档案"><DataGrid x:Name="ProductGrid" AutoGenerateColumns="True" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="0" CanUserAddRows="False"/></TabItem><TabItem Header="仓库"><DataGrid x:Name="WarehouseGrid" AutoGenerateColumns="True" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="0" CanUserAddRows="False"/></TabItem><TabItem Header="库位"><DataGrid x:Name="LocationGrid" AutoGenerateColumns="True" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="0" CanUserAddRows="False"/></TabItem></TabControl></Grid></TabItem>
                <TabItem Header="销售订单" Padding="14,7"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="单号" Foreground="#64748B" VerticalAlignment="Center"/><TextBox x:Name="SalesNoBox" Width="120" Text="SO-NEW-001"/><TextBlock Text="客户" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><ComboBox x:Name="SalesCustomerBox" Width="150" DisplayMemberPath="Name" SelectedValuePath="Code"/><TextBlock Text="SKU（可多条）" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><ComboBox x:Name="SalesSkuBox" Width="135" DisplayMemberPath="Sku" SelectedValuePath="Sku"/><TextBlock Text="数量" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="SalesQtyBox" Width="55" Text="10"/><TextBlock Text="交期" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="SalesRequiredBox" Width="95" Text="2026-09-30"/><Button Content="保存草稿" Click="CreateSalesOrder_Click"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0"><Button Content="提交审核" Tag="submit" Click="SalesAction_Click"/><Button Content="审核" Tag="approve" Click="SalesAction_Click"/><Button Content="反审核" Tag="reverse-approve" Click="SalesAction_Click"/><Button Content="作废" Tag="cancel" Click="SalesAction_Click"/><Button Content="下推发货通知" Click="PushSales_Click"/><TextBlock Text="选择订单后执行状态流转或下推" Foreground="#64748B" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel><DataGrid x:Name="SalesOrderGrid" Grid.Row="2" AutoGenerateColumns="True" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="0" CanUserAddRows="False" Margin="0,14,0,0"/></Grid></TabItem>
                 <TabItem Header="计划协同" Padding="14,7"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Button Content="运行 MRP" Click="RunMrp_Click"/><Button Content="下推生产建议" Click="PushMrpProduction_Click"/><Button Content="下推采购建议" Click="PushMrpPurchase_Click"/><TextBlock Text="基于已审核销售订单、BOM、库存和安全库存计算生产/采购建议" Foreground="#64748B" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="成品" Foreground="#64748B" VerticalAlignment="Center"/><TextBox x:Name="BomProductBox" Width="78" Text="FG-2001"/><TextBlock Text="版本" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="BomVersionBox" Width="55" Text="V1.1"/><TextBlock Text="子件" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="BomComponentBox" Width="78" Text="RM-1001"/><TextBlock Text="用量" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="BomQtyBox" Width="45" Text="1"/><TextBlock Text="损耗" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="BomScrapBox" Width="50" Text="0.02"/><Button Content="新建 BOM" Click="CreateBom_Click"/><Button Content="编辑选中 BOM" Click="EditBom_Click"/><Button Content="停用选中 BOM" Click="DisableBom_Click"/></StackPanel><TabControl Grid.Row="2" Margin="0,14,0,0"><TabItem Header="BOM"><DataGrid x:Name="BomGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" BorderThickness="0"/></TabItem><TabItem Header="收货通知"><DataGrid x:Name="ReceiptNoticeGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" BorderThickness="0"/></TabItem><TabItem Header="生产订单"><DataGrid x:Name="ProductionOrderGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" BorderThickness="0"/></TabItem><TabItem Header="MRP 建议"><DataGrid x:Name="MrpGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" BorderThickness="0"/></TabItem></TabControl></Grid></TabItem>
                <TabItem Header="发货通知" Padding="14,7"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Button Content="提交审核" Tag="submit" Click="DeliveryAction_Click"/><Button Content="审核" Tag="approve" Click="DeliveryAction_Click"/><Button Content="反审核" Tag="reverse-approve" Click="DeliveryAction_Click"/><Button Content="作废" Tag="cancel" Click="DeliveryAction_Click"/><Button Content="下推销售出库单" Click="PushDelivery_Click"/><TextBlock Text="销售订单审核后生成，通知单审核后进入仓库出库作业" Foreground="#64748B" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel><DataGrid x:Name="DeliveryNoticeGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="0" CanUserAddRows="False" Margin="0,14,0,0"/></Grid></TabItem>
